# --- Samba AD DC ---------------------------------------------------------
# Short domain (NetBIOS) name: no dots, 15 chars max.
AD_DOMAIN=AD
# Kerberos realm: uppercase DNS name you want the domain to use.
AD_REALM=AD.EXAMPLE.COM
# Administrator password. Samba requires complexity (upper/lower/digit/symbol).
ADMIN_PASS=Passw0rd!2026
# Upstream DNS used by the AD DNS server.
DNS_FORWARDER=1.1.1.1

# --- LAM GUI -------------------------------------------------------------
# No password here: start.sh creates LAM's "lam" profile automatically.
# LAM master password (only for creating/renaming profiles) is: lam
# Web login uses Administrator@<AD_REALM> and ADMIN_PASS.
